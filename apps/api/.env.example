# Core API RESERVA (microservice santé / restauration / admin / économie)
# Copiez vers apps/api/.env

DATABASE_URL="postgresql://reserva:reserva@localhost:55432/reserva?schema=core"
REDIS_URL="redis://localhost:6380"
PORT=4101
NODE_ENV=development

JWT_SECRET="changez-cette-valeur-en-production-avec-une-chaine-aleatoire-longue"
JWT_EXPIRATION="7d"

MODE_PAIEMENT=simulation
MODE_SMS=simulation
# production = hub AfriSoft (HMAC serveur uniquement)
# MODE_SMS=production
AFRISOFT_SMS_HUB_URL=https://sms.afri-soft.com
AFRISOFT_HUB_APP_ID=
AFRISOFT_HUB_API_KEY=

# Google Sign-In (Client IDs OAuth séparés par virgules : Web + Android + iOS)
MODE_GOOGLE=simulation
GOOGLE_CLIENT_IDS=

MPESA_API_KEY=
AIRTEL_MONEY_API_KEY=
ORANGE_MONEY_API_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

CRON_SECRET="generez-une-chaine-aleatoire-longue-ici"

# Console admin Next.js
WEB_URL="http://localhost:3001"
