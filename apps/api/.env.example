# Core API RESERVA (microservice santé / restauration / admin / économie)
# Copiez vers apps/api/.env

DATABASE_URL="postgresql://reserva:reserva@localhost:55432/reserva?schema=core"
REDIS_URL="redis://localhost:6380"
PORT=4101
NODE_ENV=development

JWT_SECRET="changez-cette-valeur-en-production-avec-une-chaine-aleatoire-longue"
JWT_EXPIRATION="7d"

MODE_PAIEMENT=simulation
# Délai anti-litige avant libération du séquestre (heures)
SEQUESTRE_DELAI_HEURES=48
MODE_SMS=simulation
# production = hubs AfriSoft (HMAC serveur uniquement — jamais dans Flutter / web)
# MODE_SMS=production
# MODE_PAIEMENT=production
AFRISOFT_SMS_HUB_URL=https://sms.afri-soft.com
AFRISOFT_PAY_HUB_URL=https://pay.afri-soft.com
AFRISOFT_HUB_APP_ID=
AFRISOFT_HUB_API_KEY=
# Optionnel : secret dédié webhooks hub → API (sinon = API_KEY)
AFRISOFT_HUB_WEBHOOK_SECRET=

# Google Sign-In (Client IDs OAuth séparés par virgules : Web + Android + iOS)
MODE_GOOGLE=simulation
GOOGLE_CLIENT_IDS=

# Sign in with Apple (App Store 4.8) — audiences = bundle IDs
MODE_APPLE=simulation
APPLE_CLIENT_IDS=com.reserva.client,com.reserva.pro

# Anciennes clés opérateurs — non utilisées (tout passe par le hub AfriSoft)
MPESA_API_KEY=
AIRTEL_MONEY_API_KEY=
ORANGE_MONEY_API_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

CRON_SECRET="generez-une-chaine-aleatoire-longue-ici"

# Console admin Next.js
WEB_URL="http://localhost:3001"

# LiveKit Cloud — appels vocaux (optionnel en local ; requis en prod pour /voix)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
