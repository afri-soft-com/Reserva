# Copiez ce fichier en .env et renseignez vos propres valeurs

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/reserva?schema=public"

# Serveur
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="changez-cette-valeur-en-production-avec-une-chaine-aleatoire-longue"
JWT_EXPIRATION="7d"

# Mode des adaptateurs externes : "simulation" ou "production"
# En mode simulation, aucune clé API réelle n'est requise — utile pour développer sans compte opérateur.
MODE_PAIEMENT=simulation
MODE_SMS=simulation

# Clés réelles (uniquement nécessaires si MODE_PAIEMENT=production)
MPESA_API_KEY=
AIRTEL_MONEY_API_KEY=
ORANGE_MONEY_API_KEY=

# SMS (Africa's Talking ou équivalent) — uniquement si MODE_SMS=production
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Sécurité des tâches planifiées (rappels SMS automatiques)
CRON_SECRET="generez-une-chaine-aleatoire-longue-ici"

# URL du frontend web (pour CORS)
WEB_URL="http://localhost:3000"
