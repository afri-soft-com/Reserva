// Schéma de base de données RESERVA
// Voir docs/cahier-des-charges.md pour le détail fonctionnel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



// ----------------------------------------------------------------------------
// MODÈLES
// ----------------------------------------------------------------------------

model Utilisateur {
  id               String   @id @default(uuid())
  telephone        String   @unique
  email            String?  @unique
  googleId         String?  @unique
  nom              String
  pinHash          String?
  role             String @default("CLIENT")
  langue           String @default("fr")
  photoUrl         String?
  telephoneVerifie Boolean  @default(false)
  deuxFAActif      Boolean  @default(false)
  tentativesPin    Int      @default(0)
  bloqueJusquA     DateTime?
  creeLe           DateTime @default(now())
  misAJourLe       DateTime @updatedAt

  otps             Otp[]
  prestataire      Prestataire?
  reservations     Reservation[]
  avis             Avis[]
  notifications    Notification[]
  favoris          Favori[]
  conversations    ConversationParticipant[]
  messagesEnvoyes  Message[]
  pointsFidelite   PointTransaction[]
  avoirs           Avoir[]
  alertesDisponibilite AlerteDisponibilite[]
  listeAttente     ListeAttente[]

  codeParrainage   String?          @unique
  parraineParId    String?
  parrainePar      Utilisateur?     @relation("Parrainage", fields: [parraineParId], references: [id])
  parraines        Utilisateur[]    @relation("Parrainage")
  cartesAchetees   CarteCadeau[]    @relation("CartesAchetees")
  cartesRecues     CarteCadeau[]    @relation("CartesRecues")
  beneficiaires    Beneficiaire[]
  litigesOuverts   Litige[]         @relation("LitigesOuverts")
  reservationsAgent Reservation[]   @relation("ReservationsAgent")
  commissionAgentPourcent Float     @default(2)

  @@map("utilisateurs")
}

model Otp {
  id           String   @id @default(uuid())
  utilisateurId String
  utilisateur  Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  code         String
  expireLe     DateTime
  utilise      Boolean  @default(false)
  tentatives   Int      @default(0)
  creeLe       DateTime @default(now())

  @@index([utilisateurId])
  @@map("otps")
}

model Prestataire {
  id                              String   @id @default(uuid())
  utilisateurId                   String   @unique
  utilisateur                     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nomEntreprise                   String
  categorie                       String
  ville                           String
  quartier                        String
  adresse                         String?
  description                     String?
  documentJustificatifUrl         String?
  latitude                        Float?
  longitude                       Float?
  statut                          String @default("EN_ATTENTE_VALIDATION")
  motifRejet                      String?

  /// KYC complet — dossier d'identité / entreprise
  /// BROUILLON | EN_REVUE | INFO_MANQUANTE | VALIDE | REFUSE
  kycStatut                       String   @default("BROUILLON")
  pieceIdentiteType               String?  // CNI | PASSEPORT | PERMIS
  pieceIdentiteNumero             String?
  pieceIdentiteRectoUrl           String?
  pieceIdentiteVersoUrl           String?
  selfieUrl                       String?
  rccm                            String?
  nif                             String?
  adresseLegale                   String?
  documentRccmUrl                 String?
  documentNifUrl                  String?
  attestationUrl                  String?
  kycSoumisLe                     DateTime?
  kycValideLe                     DateTime?
  kycMotifRejet                   String?
  kycRevuParId                    String?

  noteMoyenne                     Float    @default(0)
  nombreAvis                      Int      @default(0)
  /// Score 0–100 : avis + completion + ponctualité + badge terrain
  scoreConfiance                  Float    @default(50)
  tauxCompletionPourcent          Float    @default(100)
  tauxPonctualitePourcent         Float    @default(100)
  badgeVerifieTerrain             Boolean  @default(false)
  delaiAnnulationGratuiteHeures   Int      @default(24)
  fraisAnnulationTardivePourcent  Int      @default(50)
  tauxCommissionPourcent          Float    @default(4)
  creeLe                          DateTime @default(now())
  misAJourLe                      DateTime @updatedAt

  services      ServiceOffert[]
  reservations  Reservation[]
  avis          Avis[]
  abonnements   AbonnementPrestataire[]
  packages      PackageService[]
  periodesIndisponibles PeriodeIndisponible[]
  ecritures     EcritureComptable[]
  versements    VersementPrestataire[]

  @@index([categorie, ville])
  @@index([scoreConfiance])
  @@index([kycStatut])
  @@map("prestataires")
}

model ServiceOffert {
  id              String   @id @default(uuid())
  prestataireId   String
  prestataire     Prestataire @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  nom             String
  description     String?
  dureeMinutes    Int      @default(30)
  prix            Float
  devise          String   @default("CDF")
  actif           Boolean  @default(true)
  creeLe          DateTime @default(now())

  creneaux        Creneau[]
  reservations    Reservation[]
  favoris         Favori[]
  packageItems    PackageServiceItem[]
  alertes         AlerteDisponibilite[]
  listeAttente    ListeAttente[]
  periodesIndisponibles PeriodeIndisponible[]

  @@index([prestataireId])
  @@map("services_offerts")
}

model Creneau {
  id               String   @id @default(uuid())
  serviceId        String
  service          ServiceOffert @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  debut            DateTime
  fin              DateTime
  capaciteTotale   Int      @default(1)
  capaciteReservee Int      @default(0)
  creeLe           DateTime @default(now())

  reservations     Reservation[]
  listeAttente     ListeAttente[]

  @@index([serviceId, debut])
  @@map("creneaux")
}

model Reservation {
  id                  String   @id @default(uuid())
  numero              String   @unique
  clientId            String
  client              Utilisateur @relation(fields: [clientId], references: [id])
  prestataireId       String
  prestataire         Prestataire @relation(fields: [prestataireId], references: [id])
  serviceId           String
  service             ServiceOffert @relation(fields: [serviceId], references: [id])
  creneauId           String
  creneau             Creneau @relation(fields: [creneauId], references: [id])
  statut              String @default("EN_ATTENTE")
  statutPaiement      String @default("EN_ATTENTE")
  montantTotal        Float
  montantPaye         Float    @default(0)
  devise              String   @default("CDF")
  montantReduction    Float    @default(0)
  pointsUtilises      Int      @default(0)
  avoirUtilise        Float    @default(0)
  montantCommission      Float    @default(0)
  montantFraisService    Float    @default(0)
  montantNetPrestataire  Float    @default(0)
  tauxCommissionApplique Float    @default(0)
  commissionStatut       String   @default("EN_ATTENTE")
  notes               String?
  reservePourTiers    Boolean  @default(false)
  nomTiers            String?
  telephoneTiers      String?
  /// JSON : [{ "nom", "telephone", "lien" }] — kit famille / groupe
  beneficiairesJson   String?
  /// Garantie arrivée RESERVA (crédit auto si non délivré)
  garantieActive      Boolean  @default(true)
  garantieUtilisee    Boolean  @default(false)
  /// Acompte % demandé à la réservation (solde J-1 / sur place)
  acomptePourcent     Int      @default(30)
  agentId             String?
  agent               Utilisateur? @relation("ReservationsAgent", fields: [agentId], references: [id])
  motifAnnulation     String?
  codePromoId         String?
  codePromo           CodePromo? @relation(fields: [codePromoId], references: [id])
  creeLe              DateTime @default(now())
  misAJourLe          DateTime @updatedAt

  transactions        Transaction[]
  avis                Avis?
  ecritures           EcritureComptable[]
  notifications       Notification[]
  carteCadeauId       String?
  carteCadeau         CarteCadeau? @relation(fields: [carteCadeauId], references: [id])
  packageId           String?
  package             PackageService? @relation(fields: [packageId], references: [id])
  recurrenceGroupeId  String? // identifiant de la série (réservation récurrente) le cas échéant
  litiges             Litige[]

  @@index([clientId])
  @@index([prestataireId])
  @@index([statut])
  @@index([agentId])
  @@map("reservations")
}

model CodePromo {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  type        String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  valeur      Float
  devise      String   @default("CDF")
  montantMin  Float?
  usageMax    Int?
  usageCount  Int      @default(0)
  dateDebut   DateTime
  dateFin     DateTime
  actif       Boolean  @default(true)
  creeParId   String?
  creeLe      DateTime @default(now())
  misAJourLe  DateTime @updatedAt

  reservations Reservation[]

  @@map("codes_promo")
}

model Transaction {
  id               String   @id @default(uuid())
  reservationId    String
  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  operateur        String
  montant          Float
  devise           String
  statut           String
  referenceExterne String?
  telephonePaiement String?
  creeLe           DateTime @default(now())

  @@index([reservationId])
  @@unique([referenceExterne])
  @@map("transactions")
}

model AuditAdmin {
  id            String   @id @default(uuid())
  adminId       String
  action        String
  cibleType     String?
  cibleId       String?
  details       String?
  creeLe        DateTime @default(now())

  @@index([adminId, creeLe])
  @@index([action, creeLe])
  @@map("audits_admin")
}

model Avis {
  id                  String   @id @default(uuid())
  reservationId       String   @unique
  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  clientId            String
  client              Utilisateur @relation(fields: [clientId], references: [id])
  prestataireId       String
  prestataire         Prestataire @relation(fields: [prestataireId], references: [id])
  note                Int
  commentaire         String?
  photosUrl           String?
  reponsePrestataire  String?
  modere              Boolean @default(false)
  creeLe              DateTime @default(now())

  @@index([prestataireId])
  @@map("avis")
}

model Favori {
  id              String   @id @default(uuid())
  utilisateurId   String
  serviceId       String
  creeLe          DateTime @default(now())

  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  service         ServiceOffert @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, serviceId])
  @@map("favoris")
}

model Notification {
  id            String   @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  titre         String
  message       String
  type          String
  lu            Boolean  @default(false)
  creeLe        DateTime @default(now())

  @@index([utilisateurId, lu])
  @@map("notifications")
}

model PlanAbonnement {
  id                String   @id @default(uuid())
  nom               String
  description       String?
  prix              Float
  devise            String   @default("CDF")
  dureeJours        Int
  maxServices       Int?
  commissionReduite Float?
  fonctionnalites   String   @default("[]")
  actif             Boolean  @default(true)
  creeLe            DateTime @default(now())
  misAJourLe        DateTime @updatedAt

  abonnements       AbonnementPrestataire[]

  @@map("plans_abonnement")
}

model AbonnementPrestataire {
  id               String   @id @default(uuid())
  prestataireId    String
  planId           String
  dateDebut        DateTime
  dateFin          DateTime
  statut           String   @default("ACTIF")
  montantPaye      Float    @default(0)
  operateurPaiement String?
  referencePaiement String?
  statutPaiement   String   @default("GRATUIT")
  creeLe           DateTime @default(now())
  misAJourLe       DateTime @updatedAt

  prestataire   Prestataire       @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  plan          PlanAbonnement    @relation(fields: [planId], references: [id])

  @@index([prestataireId])
  @@index([planId])
  @@index([statut])
  @@map("abonnements_prestataire")
}

model EcritureComptable {
  id            String   @id @default(uuid())
  type          String
  compte        String
  sens          String
  montant       Float
  devise        String   @default("CDF")
  prestataireId String?
  prestataire   Prestataire? @relation(fields: [prestataireId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  abonnementId  String?
  versementId   String?
  description   String?
  creeLe        DateTime @default(now())

  @@index([compte, prestataireId])
  @@index([type, creeLe])
  @@index([reservationId])
  @@map("ecritures_comptables")
}

model VersementPrestataire {
  id                String    @id @default(uuid())
  prestataireId     String
  prestataire       Prestataire @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  montant           Float
  devise            String    @default("CDF")
  statut            String    @default("DEMANDE")
  operateur         String?
  telephonePaiement String?
  referenceExterne  String?
  noteAdmin         String?
  demandeLe         DateTime  @default(now())
  traiteLe          DateTime?
  creeLe            DateTime  @default(now())

  @@index([prestataireId, statut])
  @@map("versements_prestataire")
}

model ConfigurationTarification {
  id          String   @id @default(uuid())
  cle         String   @unique
  valeur      String
  description String?
  type        String   @default("TEXTE")
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())
  misAJourLe  DateTime @updatedAt

  @@map("configurations_tarification")
}

model Conversation {
  id        String   @id @default(uuid())
  sujet     String?
  creeLe    DateTime @default(now())
  misAJourLe DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  utilisateurId   String
  utilisateur     Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  derniereLecture DateTime?
  creeLe          DateTime     @default(now())

  @@unique([conversationId, utilisateurId])
  @@map("conversations_participants")
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  envoyeurId      String
  envoyeur        Utilisateur  @relation(fields: [envoyeurId], references: [id])
  contenu         String
  imageUrl        String?
  lu              Boolean      @default(false)
  luLe            DateTime?
  creeLe          DateTime     @default(now())

  @@index([conversationId, creeLe])
  @@map("messages")
}

model Publicite {
  id          String   @id @default(uuid())
  titre       String
  imageUrl    String?
  lienUrl     String?
  description String?
  actif       Boolean  @default(true)
  dateDebut   DateTime @default(now())
  dateFin     DateTime?
  cible       String   @default("TOUS")
  impressions Int      @default(0)
  clics       Int      @default(0)
  /// GRATUIT | FORFAIT | CPM | CPC
  modeleFacturation String  @default("GRATUIT")
  prixCampagne      Float?
  devise            String  @default("CDF")
  annonceurNom      String?
  creeLe      DateTime @default(now())
  misAJourLe  DateTime @updatedAt

  @@map("publicites")
}

model PointTransaction {
  id              String   @id @default(uuid())
  utilisateurId   String
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type            String      // GAIN | DEPENSE
  montantPoints   Int
  soldeApres      Int
  reservationId   String?
  description     String?
  creeLe          DateTime @default(now())

  @@index([utilisateurId])
  @@map("points_fidelite")
}

model CarteCadeau {
  id              String       @id @default(uuid())
  code            String       @unique
  acheteurId      String
  acheteur        Utilisateur  @relation("CartesAchetees", fields: [acheteurId], references: [id])
  montant         Float
  solde           Float
  devise          String       @default("CDF")
  beneficiaireId  String?
  beneficiaire    Utilisateur? @relation("CartesRecues", fields: [beneficiaireId], references: [id])
  actif           Boolean      @default(true)
  dateExpiration  DateTime?
  creeLe          DateTime     @default(now())

  reservations    Reservation[]

  @@index([acheteurId])
  @@index([beneficiaireId])
  @@map("cartes_cadeaux")
}

model PackageService {
  id              String   @id @default(uuid())
  prestataireId   String
  prestataire     Prestataire @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  nom             String
  description     String?
  prix            Float
  devise          String   @default("CDF")
  actif           Boolean  @default(true)
  /// Pack corridor voyage+soins (ex. province → Kin)
  estCorridor             Boolean  @default(false)
  corridorOrigine         String?
  corridorDestination     String?
  creeLe          DateTime @default(now())
  misAJourLe      DateTime @updatedAt

  services        PackageServiceItem[]
  reservations    Reservation[]

  @@index([prestataireId])
  @@index([estCorridor])
  @@map("packages_services")
}

model PackageServiceItem {
  id          String         @id @default(uuid())
  packageId   String
  package     PackageService @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId   String
  service     ServiceOffert  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@map("packages_services_items")
}

model Avoir {
  id                String    @id @default(uuid())
  utilisateurId     String
  utilisateur       Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  montantInitial    Float
  montantRestant    Float
  devise            String    @default("CDF")
  sourceReservationId String?
  statut            String    @default("ACTIF") // ACTIF | UTILISE | EXPIRE
  dateExpiration    DateTime?
  creeLe            DateTime  @default(now())

  @@index([utilisateurId, statut])
  @@map("avoirs")
}

model AlerteDisponibilite {
  id            String    @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  serviceId     String
  service       ServiceOffert @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  actif         Boolean   @default(true)
  creeLe        DateTime  @default(now())

  @@unique([utilisateurId, serviceId])
  @@index([serviceId, actif])
  @@map("alertes_disponibilite")
}

model ListeAttente {
  id            String     @id @default(uuid())
  clientId      String
  client        Utilisateur @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId     String
  service       ServiceOffert @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  creneauId     String
  creneau       Creneau    @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  statut        String     @default("EN_ATTENTE") // EN_ATTENTE | NOTIFIE | RESERVE | RETIRE
  creeLe        DateTime   @default(now())

  @@index([creneauId, statut])
  @@index([clientId])
  @@map("liste_attente")
}

model PeriodeIndisponible {
  id            String          @id @default(uuid())
  prestataireId String
  prestataire   Prestataire     @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       ServiceOffert?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  dateDebut     DateTime
  dateFin       DateTime
  motif         String?
  creeLe        DateTime        @default(now())

  @@index([prestataireId, dateDebut, dateFin])
  @@map("periodes_indisponibles")
}

/// Membres du foyer / groupe (kit famille)
model Beneficiaire {
  id            String   @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nom           String
  telephone     String?
  lienParente   String   @default("AUTRE") // ENFANT | EPOUX | PARENT | AMI | AUTRE
  creeLe        DateTime @default(now())

  @@index([utilisateurId])
  @@map("beneficiaires")
}

/// Médiation / litige avec preuves
model Litige {
  id              String   @id @default(uuid())
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ouvertParId     String
  ouvertPar       Utilisateur @relation("LitigesOuverts", fields: [ouvertParId], references: [id])
  motif           String
  description     String?
  preuvesJson     String?  // JSON URLs / data-URIs
  statut          String   @default("OUVERT") // OUVERT | EN_MEDIATION | TRANCHE | REJETE
  decision        String?
  montantAvoir    Float?
  trancheParId    String?
  creeLe          DateTime @default(now())
  misAJourLe      DateTime @updatedAt

  @@index([reservationId])
  @@index([statut])
  @@map("litiges")
}

/// Canal SMS/USSD simulé (inbound)
model CommandeSms {
  id            String   @id @default(uuid())
  telephone     String
  texteBrut     String
  interpreteJson String?
  statut        String   @default("RECU") // RECU | TRAITE | ERREUR
  resultat      String?
  creeLe        DateTime @default(now())

  @@index([telephone, creeLe])
  @@map("commandes_sms")
}
