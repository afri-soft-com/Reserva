default_platform(:ios)

platform :ios do
  desc "Upload IPA Client + Pro sur App Store Connect (soumission review)"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: "fastlane/AuthKey_#{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}.p8",
      duration: 1200,
      in_house: false
    )

    # cwd fastlane = ios/fastlane → remonter vers apps/mobile_flutter/build/ios/ipa
    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipas = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("Aucun IPA sous #{ipa_dir} (#{Dir.glob(File.join(ipa_dir, '*')).inspect})") if ipas.empty?

    # 1er upload : metadata/screenshots incomplets → pas de submit auto review
    submit = ENV.fetch("ASC_SUBMIT_FOR_REVIEW", "false") == "true"

    ipas.sort.each do |ipa|
      UI.message("→ App Store Connect #{File.basename(ipa)} (submit_for_review=#{submit})")
      upload_to_app_store(
        api_key: api_key,
        ipa: File.expand_path(ipa),
        submit_for_review: submit,
        automatic_release: false,
        force: true,
        precheck_include_in_app_purchases: false,
        skip_metadata: true,
        skip_screenshots: true
      )
    end
  end
end
