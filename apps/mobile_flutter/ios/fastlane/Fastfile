require "timeout"

default_platform(:ios)

platform :ios do
  desc "Upload IPA Client + Pro sur App Store Connect (soumission review)"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: "fastlane/AuthKey_#{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}.p8",
      duration: 1200,
      in_house: false
    )

    # cwd fastlane = ios/fastlane → remonter vers apps/mobile_flutter/build/ios/ipa
    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipas = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("Aucun IPA sous #{ipa_dir} (#{Dir.glob(File.join(ipa_dir, '*')).inspect})") if ipas.empty?

    # Soumission review + release auto dès approbation Apple (ASC_SUBMIT_FOR_REVIEW=false pour désactiver)
    submit = ENV.fetch("ASC_SUBMIT_FOR_REVIEW", "true") == "true"
    auto_release = ENV.fetch("ASC_AUTOMATIC_RELEASE", "true") == "true"

    # 1) Envoi des binaires sans attendre le traitement Apple (sinon le job reste bloqué des heures
    #    si un build n'apparaît pas dans la liste).
    ipas.sort.each do |ipa|
      identifiant = File.basename(ipa).include?("Pro") ? "com.reserva.pro" : "com.reserva.client"
      UI.message("→ Upload binaire #{File.basename(ipa)} (#{identifiant})")
      upload_to_app_store(
        api_key: api_key,
        app_identifier: identifiant,
        ipa: File.expand_path(ipa),
        submit_for_review: false,
        automatic_release: false,
        force: true,
        precheck_include_in_app_purchases: false,
        skip_metadata: true,
        skip_screenshots: true
      )
    end

    # 2) Soumission review, plafonnée : le binaire est déjà chez Apple même si le build n'est pas encore listé.
    if submit
    ipas.sort.each do |ipa|
      identifiant = File.basename(ipa).include?("Pro") ? "com.reserva.pro" : "com.reserva.client"
      UI.message("→ Soumission review #{File.basename(ipa)} (#{identifiant})")
      begin
        Timeout.timeout(20 * 60) do
          upload_to_app_store(
            api_key: api_key,
            app_identifier: identifiant,
            ipa: File.expand_path(ipa),
            submit_for_review: true,
            automatic_release: auto_release,
            skip_binary_upload: true,
            force: true,
            precheck_include_in_app_purchases: false,
            skip_metadata: true,
            skip_screenshots: true
          )
        end
      rescue Timeout::Error
        UI.important("Build #{File.basename(ipa)} pas encore listé après 20 min. Binaire déjà envoyé à App Store Connect.")
      rescue StandardError => e
        UI.important("Soumission review #{File.basename(ipa)} non terminée (binaire déjà envoyé) : #{e.message}")
      end
    end
    end
  end
end
