default_platform(:ios)

platform :ios do
  desc "Upload IPA Client + Pro sur App Store Connect (soumission review)"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: "fastlane/AuthKey_#{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}.p8",
      duration: 1200,
      in_house: false
    )

    # flutter build ipa produit un IPA nommé d'après le product ; on mappe par bundle
    ipas = Dir.glob("../build/ios/ipa/*.ipa")
    UI.user_error!("Aucun IPA sous build/ios/ipa") if ipas.empty?

    # Déploie chaque IPA trouvé (client puis pro si deux builds)
    ipas.sort.each do |ipa|
      UI.message("→ App Store #{File.basename(ipa)}")
      upload_to_app_store(
        api_key: api_key,
        ipa: File.expand_path(ipa),
        submit_for_review: true,
        automatic_release: false,
        force: true,
        precheck_include_in_app_purchases: false,
        skip_metadata: true,
        skip_screenshots: true
      )
    end
  end
end
