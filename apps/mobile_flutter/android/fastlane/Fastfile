default_platform(:android)

platform :android do
  desc "Upload AAB Client + Pro sur Google Play (internal, completed)"
  lane :deploy do
    {
      "com.reserva.client" => File.expand_path("../../build/app/outputs/bundle/clientRelease/app-client-release.aab", __dir__),
      "com.reserva.pro" => File.expand_path("../../build/app/outputs/bundle/proRelease/app-pro-release.aab", __dir__),
    }.each do |package_name, aab|
      UI.user_error!("AAB introuvable: #{aab}") unless File.exist?(aab)
      UI.message("→ Play Store #{package_name}")
      attempts = 0
      begin
        attempts += 1
        # internal + completed = dispo aux testeurs ; PLAY_TRACK / PLAY_RELEASE_STATUS pour override
        upload_to_play_store(
          package_name: package_name,
          track: ENV.fetch("PLAY_TRACK", "internal"),
          aab: aab,
          json_key: "play-service-account.json",
          skip_upload_metadata: true,
          skip_upload_images: true,
          skip_upload_screenshots: true,
          skip_upload_changelogs: true,
          # completed = dispo immédiatement aux testeurs du track (internal)
          release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
          ack_bundle_installation_warning: true,
          timeout: 600,
          # true si une review Play bloque l'edit ; sinon false pour publier le track
          changes_not_sent_for_review: ENV.fetch("PLAY_CHANGES_NOT_SENT_FOR_REVIEW", "false") == "true"
        )
      rescue => e
        msg = e.message.to_s
        if attempts < 3 && msg.match?(/edit has expired|Edit.*expired|rateLimitExceeded|503|500/i)
          UI.important("Play API retry #{attempts}/3 pour #{package_name}: #{msg}")
          sleep(15 * attempts)
          retry
        end
        raise
      end
    end
  end
end
