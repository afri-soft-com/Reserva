default_platform(:android)

platform :android do
  desc "Upload AAB Client + Pro sur Google Play (production)"
  lane :deploy do
    {
      "com.reserva.client" => File.expand_path("../../build/app/outputs/bundle/clientRelease/app-client-release.aab", __dir__),
      "com.reserva.pro" => File.expand_path("../../build/app/outputs/bundle/proRelease/app-pro-release.aab", __dir__),
    }.each do |package_name, aab|
      UI.user_error!("AAB introuvable: #{aab}") unless File.exist?(aab)
      UI.message("→ Play Store #{package_name}")
      publier_production(package_name, aab)
    end
  end
end

def publier_production(package_name, aab)
  statut = ENV.fetch("PLAY_RELEASE_STATUS", "completed")
  begin
    envoyer_play(package_name, aab, statut, false)
  rescue StandardError => e
    msg = e.message.to_s
    raise unless msg.match?(/Precondition|draft app|FAILED_PRECONDITION/i)

    UI.important("Production « #{statut} » refusée pour #{package_name}: #{msg}")
    UI.important("Repli : release sur le track production en brouillon (Google n'accepte pas completed tant que l'app n'est pas sortie du brouillon).")
    envoyer_play(package_name, aab, "draft", true)
  end
end

def envoyer_play(package_name, aab, release_status, changes_not_sent)
  upload_to_play_store(
    package_name: package_name,
    track: ENV.fetch("PLAY_TRACK", "production"),
    aab: aab,
    json_key: "play-service-account.json",
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: false,
    release_status: release_status,
    ack_bundle_installation_warning: true,
    timeout: 600,
    changes_not_sent_for_review: changes_not_sent
  )
end
