{
  "name": "reserva-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "RESERVA - Application de reservation planifiee pour la RDCongo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "cd apps/mobile_flutter && flutter run",
    "analyze:mobile": "cd apps/mobile_flutter && dart analyze lib/",
    "pub:mobile": "cd apps/mobile_flutter && flutter pub get",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "styled-jsx": "^5.1.7"
  }
}
